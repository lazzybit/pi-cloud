{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["*.ts", "src/**/*", "test/*.ts"]
}
