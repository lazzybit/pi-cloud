{
  "type": "module",
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@orpc/client": "1.16.4",
    "@orpc/contract": "1.16.4",
    "@orpc/openapi": "1.16.4",
    "@orpc/openapi-client": "1.16.4",
    "@orpc/server": "1.16.4",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "name": "pi-cloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build -w web && esbuild harness/server.ts --bundle --platform=node --format=esm --packages=external --outfile=harness/dist/server.mjs",
    "test": "vitest run --config tests/vitest.config.ts",
    "check": "tsc --noEmit && npm run check -w web",
    "guard": "cc -Os -o sandbox/guard sandbox/guard.c",
    "e2e": "npm run build && node tests/e2e/run.mjs"
  },
  "workspaces": [
    "web"
  ]
}
